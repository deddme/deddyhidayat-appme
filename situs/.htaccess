ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/media/_opt/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <If "%{REQUEST_URI} =~ m#^/media/embeds/#">
    Header set Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-modals"
    Header set X-Robots-Tag "noindex"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
